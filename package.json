{
  "name": "diskroom",
  "version": "0.1.0",
  "description": "Goal-driven disk cleanup for developers.",
  "type": "module",
  "bin": {
    "diskroom": "bin/diskroom.js"
  },
  "engines": {
    "node": ">=22.23.3"
  },
  "homepage": "https://diskroom.dev",
  "license": "MIT",
  "files": [
    "bin/",
    "src/",
    "native/index.js",
    "native/prebuilds/",
    "README.md",
    "LICENSE",
    "docs/",
    "examples/",
    "SECURITY.md",
    "native/README.md",
    "native/diskroom_native.c"
  ],
  "scripts": {
